# Dominio público definitivo de Código Impulso, con https:// y sin ruta.
# Déjalo vacío hasta registrar y conectar el dominio. No uses una URL provisional.
# Al definirlo y volver a compilar se activan canonical, sitemap e indexación.
SITE_URL=

# Crea un proyecto Supabase y copia sus credenciales públicas aquí.
# La web usa los proyectos de muestra si estas variables no están definidas.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Catálogo Nodo PC: valores públicos para la lectura en el navegador.
# Usa la URL y la publishable/anon key del mismo proyecto; nunca la service role key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
