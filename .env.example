# Crea un proyecto Supabase y copia sus credenciales públicas aquí.
# La web usa los proyectos de muestra si estas variables no están definidas.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Catálogo Nodo PC: valores públicos para la lectura en el navegador.
# Usa la URL y la publishable/anon key del mismo proyecto; nunca la service role key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
