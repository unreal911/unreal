---
import '../styles/portfolio-faq.css';

const questions = [
  {
    question: '¿Cómo empezamos?',
    answer: 'Conversamos sobre tu negocio, tus clientes y el objetivo de la web. Si tienes textos, fotos o una identidad visual, los revisamos.',
  },
  {
    question: '¿Puedo revisar el diseño?',
    answer: 'Sí. Revisamos la estructura y un prototipo visual antes de pasar al desarrollo.',
  },
  {
    question: '¿Se verá bien en celular?',
    answer: 'Sí. Adapto el diseño y la navegación a móvil, tablet y computadora.',
  },
  {
    question: '¿Cuánto cuesta y cuánto tarda?',
    answer: 'Depende de las páginas y funciones. Te envío una propuesta con alcance, presupuesto y plazos antes de empezar.',
  },
];
---

<section class="pf-faq" id="preguntas" aria-labelledby="pf-faq-title">
  <div class="pf-faq-inner">
    <div class="pf-faq-intro" data-reveal>
      <h2 id="pf-faq-title">Preguntas<br /><em>frecuentes.</em></h2>
    </div>

    <div class="pf-faq-list">
      {questions.map((item, index) => (
        <details class="pf-faq-item">
          <summary>
            <span class="pf-faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="pf-faq-question">{item.question}</span>
            <span class="pf-faq-toggle" aria-hidden="true"></span>
          </summary>
          <div class="pf-faq-answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
