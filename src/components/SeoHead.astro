---
import { site } from '../data/site';
import { canonicalUrl, serializeJsonLd, socialImageUrl } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/images/codigo-impulso-social.png' } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const socialImage = socialImageUrl(image, Astro.site);
const homepage = Astro.site ? new URL('/', Astro.site).href : undefined;
const organizationId = homepage ? `${homepage}#organization` : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: site.name,
      description: site.description,
      founder: { '@type': 'Person', name: site.fullName },
      ...(homepage ? { '@id': organizationId, url: homepage } : {}),
    },
    {
      '@type': 'WebSite',
      name: site.name,
      inLanguage: 'es-PE',
      ...(homepage ? {
        '@id': `${homepage}#website`,
        url: homepage,
        publisher: { '@id': organizationId },
      } : {}),
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={Astro.site ? 'index,follow' : 'noindex,follow'} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="es_PE" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />}
{socialImage && image === '/images/codigo-impulso-social.png' && <>
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
</>}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
{socialImage && <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />}
<script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
