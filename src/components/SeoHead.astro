---
import { site } from '../data/site';
import { canonicalUrl, serializeJsonLd, socialImageUrl } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, image = '/images/nubicore-social.png', breadcrumbs = [] } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const socialImage = socialImageUrl(image, Astro.site);
const homepage = Astro.site ? new URL('/', Astro.site).href : undefined;
const organizationId = homepage ? `${homepage}#organization` : undefined;
const logo = socialImageUrl('/images/nubicore-logo.png', Astro.site);
const breadcrumbItems = Astro.site ? breadcrumbs.map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.name,
  item: canonicalUrl(item.path, Astro.site),
})) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: site.name,
      description: site.description,
      founder: { '@type': 'Person', name: site.fullName },
      telephone: site.phone,
      areaServed: { '@type': 'Country', name: 'Perú' },
      ...(homepage ? {
        '@id': organizationId,
        url: homepage,
        image: socialImage,
        logo: { '@type': 'ImageObject', url: logo, width: 512, height: 512 },
      } : {}),
    },
    {
      '@type': 'WebSite',
      name: site.name,
      inLanguage: 'es-PE',
      ...(homepage ? {
        '@id': `${homepage}#website`,
        url: homepage,
        publisher: { '@id': organizationId },
      } : {}),
    },
    {
      '@type': 'WebPage',
      name: title,
      description,
      inLanguage: 'es-PE',
      ...(canonical && homepage ? {
        '@id': `${canonical}#webpage`,
        url: canonical,
        isPartOf: { '@id': `${homepage}#website` },
        about: { '@id': organizationId },
        ...(socialImage ? { primaryImageOfPage: { '@type': 'ImageObject', url: socialImage } } : {}),
        ...(breadcrumbItems.length > 1 ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
      } : {}),
    },
    ...(canonical && breadcrumbItems.length > 1 ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems,
    }] : []),
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={Astro.site ? 'index,follow' : 'noindex,follow'} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="es_PE" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />}
{socialImage && image === '/images/nubicore-social.png' && <>
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
</>}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
{socialImage && <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />}
<script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
