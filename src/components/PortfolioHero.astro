---
import { site } from '../data/site';
import '../styles/studio-cover.css';

interface Props { contactUrl: string; }
const { contactUrl } = Astro.props;
const previews = [
  { id: 'trama', name: 'Trama', sector: 'Moda', label: 'Catálogo de moda mayorista', href: '/proyectos/trama-mayorista/', image: '/images/trama/hero-editorial.jpg', thumb: '/images/trama/camisa-lino.jpg', alt: 'Modelo con prendas de la colección Trama', width: 1400, height: 2100 },
  { id: 'senda', name: 'Senda', sector: 'Café', label: 'Carta y reservas para una cafetería', href: '/proyectos/senda-cafe/', image: '/images/senda/hero-coffee.webp', thumb: '/images/senda/hero-coffee-thumb.webp', alt: 'Café servido en la barra de Senda', width: 1672, height: 941 },
  { id: 'nodo', name: 'Nodo PC', sector: 'Tecnología', label: 'Catálogo y configurador de PC', href: '/proyectos/nodo-pc/', image: '/images/nodo-pc-cover.webp', thumb: '/images/nodo-pc-cover.webp', alt: 'Tarjeta gráfica del catálogo de Nodo PC', width: 720, height: 720 },
];
---
<section class="studio-cover" aria-labelledby="hero-title">
  <div class="cover-grid">
    <div class="cover-copy">
      <p class="cover-kicker"><i aria-hidden="true"></i> Estudio de diseño web <span>/</span> Perú</p>
      <h1 id="hero-title">De visita<br /><em>a consulta.</em></h1>
      <p class="cover-description">Diseñamos webs y catálogos para que tus clientes encuentren lo que buscan y te escriban por WhatsApp.</p>
      <div class="cover-actions">
        <a class="pf-button pf-button-primary" href={contactUrl} target="_blank" rel="noopener noreferrer">Cotizar mi web <span aria-hidden="true">↗</span></a>
        <a class="cover-secondary" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="cover-showcase" data-showcase>
      <div class="archive-heading">
        <h2>Muestrario <em>del estudio</em></h2>
        <span aria-label="Selección actual" data-preview-count>01 / 03</span>
      </div>
      <div class="archive-spread">
        <div class="archive-index" role="group" aria-label="Elegir proyecto conceptual" data-preview-controls hidden>
          {previews.map((project, index) => (
            <button type="button" data-preview-button={index} aria-controls={`preview-${project.id}`} aria-pressed={index === 0}>
              <img src={project.thumb} width="112" height="70" alt="" />
              <span><small aria-hidden="true">0{index + 1}</small> {project.name}</span>
            </button>
          ))}
        </div>
        {previews.map((project, index) => (
          <a class={`archive-plate plate-${project.id}`} id={`preview-${project.id}`} href={project.href} data-preview={index} hidden={index !== 0} aria-label={`Ver ${project.name}, ${project.label.toLowerCase()}. Proyecto conceptual.`}>
            <img class="plate-photo" src={project.image} width={project.width} height={project.height} alt={project.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
            <span class="plate-stamp">NC / 00{index + 1} <i></i> {project.sector}</span>
            <div class="plate-caption">
              <span class="plate-class">Proyecto conceptual</span>
              <strong>{project.name}</strong>
              <div class="plate-baseline"><span>{project.label}</span><span class="plate-open">Ver caso <b aria-hidden="true">↗</b></span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="cover-colophon">
    <span><b aria-hidden="true">↳</b> {site.name} Estudio</span>
    <span>Diseño <i>/</i> Desarrollo <i>/</i> Trato directo</span>
    <a href="#servicios">Explorar servicios <span aria-hidden="true">↓</span></a>
  </div>
</section>
