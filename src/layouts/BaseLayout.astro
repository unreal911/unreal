---
import { createContactUrl, site } from '../data/site';
import SeoHead from '../components/SeoHead.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/refinements.css';
import '../styles/process.css';
import '../styles/portfolio-shell.css';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { title = site.title, description = site.description, breadcrumbs = [] } = Astro.props;
const contactUrl = createContactUrl();
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101713" />
    <SeoHead title={title} description={description} breadcrumbs={breadcrumbs} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const storageKey = 'milton-theme-v2';
        try {
          root.dataset.theme = localStorage.getItem(storageKey) === 'light' ? 'light' : 'dark';
        } catch {
          root.dataset.theme = 'dark';
        }

        const syncTheme = () => {
          const isDark = root.dataset.theme === 'dark';
          const action = isDark ? 'Modo claro' : 'Modo oscuro';
          const toggle = document.getElementById('theme-toggle');
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#101713' : '#f6f6ef');
          if (!toggle) return;
          toggle.setAttribute('aria-pressed', String(isDark));
          toggle.setAttribute('aria-label', `Cambiar a ${action.toLowerCase()}`);
          toggle.setAttribute('title', `Cambiar a ${action.toLowerCase()}`);
          const label = toggle.querySelector('.theme-toggle-label');
          if (label) label.textContent = action;
        };

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('#theme-toggle')) return;
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem(storageKey, root.dataset.theme); } catch { /* El tema sigue activo en esta visita. */ }
          syncTheme();
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncTheme, { once: true });
        } else {
          syncTheme();
        }
      })();
    </script>
  </head>
  <body>
    <a class="pf-skip-link" href="#contenido">Saltar al contenido</a>
    <div class="page-shell">
      <header class="site-header" id="top">
        <a class="wordmark" href="/" aria-label={`${site.name}, inicio`}>
          <span class="wordmark-symbol" aria-hidden="true">{site.monogram}<span class="wordmark-dot">.</span></span>
          <span class="wordmark-text" aria-hidden="true">nubi<br />core</span>
        </a>
        <nav class="site-nav" id="site-navigation" aria-label="Navegación principal">
          <a href="/#proyectos">Proyectos</a>
          <a href="/#proceso">Proceso</a>
          <a href="/#servicios">Servicios</a>
          <a href="/#sobre-mi">El estudio</a>
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar a modo claro" aria-pressed="true" title="Cambiar a modo claro">
            <span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">☾</span><span class="theme-toggle-label" aria-hidden="true">Modo claro</span>
          </button>
          <button class="menu-toggle" id="mobile-menu-toggle" type="button" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="site-navigation">
            <span class="menu-toggle-lines" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <a href={contactUrl} class="nav-contact" target="_blank" rel="noopener noreferrer" aria-label="Hablemos por WhatsApp">
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 .9A14.9 14.9 0 0 0 3.2 23.5L1 31l7.7-2A15.1 15.1 0 1 0 16 .9Zm0 27.2a12 12 0 0 1-6.1-1.7l-.5-.3-4.5 1.2 1.2-4.4-.3-.5A12.2 12.2 0 1 1 16 28.1Zm6.7-9.1c-.4-.2-2.2-1.1-2.5-1.2-.3-.1-.6-.2-.8.2-.2.4-1 1.2-1.2 1.4-.2.2-.4.3-.8.1a10 10 0 0 1-3-1.8 11 11 0 0 1-2.1-2.6c-.2-.4 0-.6.2-.8l.6-.7.4-.7c.1-.2 0-.5 0-.7l-1.1-2.7c-.3-.7-.6-.6-.8-.6h-.7c-.3 0-.7.1-1 .5s-1.3 1.3-1.3 3.1c0 1.8 1.4 3.9 1.4 3.9a14 14 0 0 0 5.4 4.3a4.3 4.3 0 0 0 2.9.9c1.2-.2 2.2-1 2.5-1.9.3-.9.3-1.7.2-1.9-.1-.2-.3-.3-.7-.5Z"/></svg>
            <span>Hablemos <span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </header>

      <main id="contenido"><slot /></main>

      <footer class="site-footer" id="contacto">
        <div class="footer-topline">
          <span>EL PRÓXIMO PROYECTO PODRÍA SER EL TUYO.</span>
          <span>DISPONIBLE PARA NUEVOS PROYECTOS <span class="status-dot" aria-hidden="true"></span></span>
        </div>
        <div class="footer-main">
          <p>Tu próximo paso.<br /><em>Hagámoslo web.</em></p>
          <a class="footer-arrow" href={contactUrl} target="_blank" rel="noopener noreferrer" aria-label={`Escribir a ${site.name} por WhatsApp`}>↗</a>
        </div>
        <a class="footer-contact-link" href={contactUrl} target="_blank" rel="noopener noreferrer">Conversemos por WhatsApp <span aria-hidden="true">↗</span></a>
        <div class="footer-bottom">
          <a href={contactUrl} target="_blank" rel="noopener noreferrer">WhatsApp {site.whatsappLabel} ↗</a>
          <span>{site.location}</span>
          <a href="#top">Volver arriba ↑</a>
          <span>© {new Date().getFullYear()} {site.name}</span>
        </div>
      </footer>
    </div>
    <div class="pf-scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a class="quick-contact" href={contactUrl} target="_blank" rel="noopener noreferrer" aria-label="Cotiza tu web por WhatsApp">
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 .9A14.9 14.9 0 0 0 3.2 23.5L1 31l7.7-2A15.1 15.1 0 1 0 16 .9Zm0 27.2a12 12 0 0 1-6.1-1.7l-.5-.3-4.5 1.2 1.2-4.4-.3-.5A12.2 12.2 0 1 1 16 28.1Zm6.7-9.1c-.4-.2-2.2-1.1-2.5-1.2-.3-.1-.6-.2-.8.2-.2.4-1 1.2-1.2 1.4-.2.2-.4.3-.8.1a10 10 0 0 1-3-1.8 11 11 0 0 1-2.1-2.6c-.2-.4 0-.6.2-.8l.6-.7.4-.7c.1-.2 0-.5 0-.7l-1.1-2.7c-.3-.7-.6-.6-.8-.6h-.7c-.3 0-.7.1-1 .5s-1.3 1.3-1.3 3.1c0 1.8 1.4 3.9 1.4 3.9a14 14 0 0 0 5.4 4.3a4.3 4.3 0 0 0 2.9.9c1.2-.2 2.2-1 2.5-1.9.3-.9.3-1.7.2-1.9-.1-.2-.3-.3-.7-.5Z"/></svg>
      <span>Cotiza tu web</span>
    </a>
    <script>
      import '../scripts/animations';
      import '../scripts/mobile-nav';
      import '../scripts/quick-contact';
      import '../scripts/portfolio';
    </script>
  </body>
</html>
