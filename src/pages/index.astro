---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHero from '../components/PortfolioHero.astro';
import PortfolioProcess from '../components/PortfolioProcess.astro';
import PortfolioFaq from '../components/PortfolioFaq.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { getProjects } from '../lib/projects';
import { getProjectPresentation } from '../lib/project-presentation';
import { site } from '../data/site';
import '../styles/portfolio-home.css';

const projects = await getProjects();
const contactUrl = `${site.whatsapp}?text=${encodeURIComponent('Hola Milton, quiero conversar sobre una página web.')}`;
const services = [
  { number: '01', title: 'Landing pages', text: 'Una página para presentar tu producto o servicio y recibir consultas.', icon: '↗' },
  { number: '02', title: 'Sitios web', text: 'Tus servicios, la información de tu negocio y el contacto, en un solo lugar.', icon: '◈' },
  { number: '03', title: 'Web a medida', text: 'Interfaces y funciones específicas para lo que necesita tu proyecto.', icon: '⌘' },
];
---

<BaseLayout>
  <div class="portfolio-home">
    <PortfolioHero contactUrl={contactUrl} />
    <div class="pf-discipline-strip" aria-label="Diseño, desarrollo y estrategia">
      <span>BUENAS IDEAS, BIEN CONSTRUIDAS.</span>
      <div><span>ESTRATEGIA</span><i aria-hidden="true">✳</i><span>DISEÑO</span><i aria-hidden="true">✳</i><span>DESARROLLO</span><i aria-hidden="true">✳</i><span>DETALLE</span></div>
    </div>
    <section class="pf-work work-section" id="proyectos" aria-labelledby="work-heading">
      <div class="pf-work-heading">
        <h2 class="pf-heading" id="work-heading" data-letters>Proyectos.</h2>
        <p data-reveal>Conceptos de diseño y desarrollo web.</p>
      </div>
      <div class="pf-project-grid">
        {projects.map((project, index) => {
          const presentation = getProjectPresentation(project);
          return (
            <article class:list={['pf-project', `pf-project-${project.artwork}`]} data-project-card aria-labelledby={`project-${project.slug}`}>
              <a class="pf-project-link" href={`/proyectos/${project.slug}/`} aria-labelledby={`project-${project.slug} project-action-${project.slug}`}>
                <div class="pf-project-cover" data-project-visual>
                  <div class="pf-project-browser" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{project.slug.replaceAll('-', '')}.concept</span><span>↗</span></div>
                  <ProjectArtwork project={project} priority={index === 0} />
                </div>
                <div class="pf-project-info" data-project-meta>
                  <div class="pf-project-copy"><h3 class="pf-project-name" id={`project-${project.slug}`}>{project.title}</h3><p class="pf-project-type">{presentation.shortCategory}</p></div>
                  <span class="pf-project-action" id={`project-action-${project.slug}`}>Ver proyecto <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </section>
    <section class="pf-manifesto" aria-labelledby="manifesto-heading">
      <h2 id="manifesto-heading" data-letters>Diseño claro.<br /><em>En cada pantalla.</em></h2>
      <div class="pf-manifesto-bottom"><a href="#proceso" aria-label="Descubrir cómo trabajo">↓</a></div>
    </section>
    <PortfolioProcess />
    <section class="pf-services" id="servicios" aria-labelledby="services-heading">
      <div class="pf-services-heading"><h2 class="pf-heading" id="services-heading" data-letters>Servicios<em>.</em></h2></div>
      <div class="pf-service-grid">{services.map((service) => <article class="pf-service" data-reveal><div class="pf-service-top"><span>{service.number} /</span><span aria-hidden="true">{service.icon}</span></div><h3>{service.title}</h3><p>{service.text}</p><a href={`${site.whatsapp}?text=${encodeURIComponent(`Hola Milton, me interesa conversar sobre ${service.title.toLowerCase()}.`)}`} target="_blank" rel="noopener noreferrer" aria-label={`Consultar sobre ${service.title.toLowerCase()}`}>Consultar <span aria-hidden="true">↗</span></a></article>)}</div>
    </section>
    <section class="pf-about" id="sobre-mi" aria-labelledby="about-heading">
      <div class="pf-about-art" aria-hidden="true"><span class="pf-about-art-label">MILTON BLAISE</span><div class="pf-monogram">mb<span>.</span></div><div class="pf-about-art-bottom"><span>DISEÑO & DESARROLLO</span><span>↗</span></div></div>
      <div class="pf-about-copy"><h2 class="pf-heading" id="about-heading" data-letters>Sobre mí<em>.</em></h2><p>Soy <strong>{site.fullName}</strong>, diseñador y desarrollador web. Te acompaño desde la idea hasta la publicación.</p><p><span class="pf-remote"><i></i> Perú · En remoto</span></p><a class="pf-text-link" href={contactUrl} target="_blank" rel="noopener noreferrer">Hablemos <span aria-hidden="true">↗</span></a></div>
    </section>
    <PortfolioFaq />
  </div>
</BaseLayout>
