---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHero from '../components/PortfolioHero.astro';
import PortfolioProcess from '../components/PortfolioProcess.astro';
import PortfolioFaq from '../components/PortfolioFaq.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { getProjects } from '../lib/projects';
import { getProjectPresentation } from '../lib/project-presentation';
import { createContactUrl, site } from '../data/site';
import '../styles/portfolio-home.css';

const projects = await getProjects();
const contactUrl = createContactUrl();
const services = [
  { number: '01', title: 'Landing pages', text: 'Una página enfocada en presentar tu oferta, lanzar una campaña o facilitar consultas.', icon: '↗', contactSubject: 'una landing page' },
  { number: '02', title: 'Webs corporativas', text: 'Un sitio para presentar tu empresa, explicar tus servicios y facilitar el contacto con tus clientes.', icon: '◈', contactSubject: 'una web corporativa' },
  { number: '03', title: 'Catálogos y web a medida', text: 'Productos, pedidos por WhatsApp e interfaces con las funciones que necesita tu negocio.', icon: '⌘', contactSubject: 'un catálogo o una web a medida' },
];
---

<BaseLayout>
  <div class="portfolio-home">
    <PortfolioHero contactUrl={contactUrl} />
    <div class="pf-discipline-strip" aria-label="Diseño, desarrollo y estrategia">
      <span>BUENAS IDEAS, BIEN CONSTRUIDAS.</span>
      <div><span>ESTRATEGIA</span><i aria-hidden="true">✳</i><span>DISEÑO</span><i aria-hidden="true">✳</i><span>DESARROLLO</span><i aria-hidden="true">✳</i><span>DETALLE</span></div>
    </div>
    <section class="pf-work work-section" id="proyectos" aria-labelledby="work-heading">
      <div class="pf-work-heading">
        <h2 class="pf-heading" id="work-heading" data-letters>Proyectos.</h2>
        <p data-reveal>Casos conceptuales para explorar cómo resolvemos distintas necesidades de negocio con diseño y desarrollo web.</p>
      </div>
      <div class="pf-project-grid">
        {projects.map((project) => {
          const presentation = getProjectPresentation(project);
          return (
            <article class:list={['pf-project', `pf-project-${project.artwork}`]} data-project-card aria-labelledby={`project-${project.slug}`}>
              <a class="pf-project-link" href={`/proyectos/${project.slug}/`} aria-labelledby={`project-${project.slug} project-action-${project.slug}`}>
                <div class="pf-project-cover" data-project-visual>
                  <div class="pf-project-browser" aria-hidden="true"><span><i></i><i></i><i></i></span><span>{project.slug.replaceAll('-', '')}.concept</span><span>↗</span></div>
                  <ProjectArtwork project={project} />
                </div>
                <div class="pf-project-info" data-project-meta>
                  <div class="pf-project-copy"><h3 class="pf-project-name" id={`project-${project.slug}`}>{project.title}</h3><p class="pf-project-type">{presentation.shortCategory}</p></div>
                  <span class="pf-project-action" id={`project-action-${project.slug}`}>Ver proyecto <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </section>
    <section class="pf-manifesto" aria-labelledby="manifesto-heading">
      <h2 id="manifesto-heading" data-letters>Diseño claro.<br /><em>Código con intención.</em></h2>
      <div class="pf-manifesto-bottom"><a href="#proceso" aria-label="Descubrir cómo trabajamos">↓</a></div>
    </section>
    <PortfolioProcess />
    <section class="pf-services" id="servicios" aria-labelledby="services-heading">
      <div class="pf-services-heading"><h2 class="pf-heading" id="services-heading" data-letters>Servicios<em>.</em></h2><p>Para negocios que comienzan y empresas que buscan renovar o ampliar su presencia digital.</p></div>
      <div class="pf-service-grid">{services.map((service) => <article class="pf-service" data-reveal><div class="pf-service-top"><span>{service.number} /</span><span aria-hidden="true">{service.icon}</span></div><h3>{service.title}</h3><p>{service.text}</p><a href={createContactUrl(`Hola ${site.name}, me interesa conversar sobre ${service.contactSubject}.`)} target="_blank" rel="noopener noreferrer" aria-label={`Consultar sobre ${service.title.toLowerCase()}`}>Consultar <span aria-hidden="true">↗</span></a></article>)}</div>
    </section>
    <section class="pf-about" id="sobre-mi" aria-labelledby="about-heading">
      <div class="pf-about-art" aria-hidden="true"><span class="pf-about-art-label">{site.name.toUpperCase()}</span><div class="pf-monogram">{site.monogram}<span>.</span></div><div class="pf-about-art-bottom"><span>DISEÑO & DESARROLLO WEB</span><span>↗</span></div></div>
      <div class="pf-about-copy"><h2 class="pf-heading" id="about-heading" data-letters>El estudio<em>.</em></h2><p><strong>{site.name}</strong> es un estudio independiente de diseño y desarrollo web. Partimos de tu negocio para dar forma a una presencia digital clara, con identidad y fácil de usar.</p><p>Lo dirige <strong>{site.fullName}</strong>. Tienes trato directo con quien diseña y desarrolla tu proyecto, desde la primera conversación hasta la publicación.</p><p><span class="pf-remote"><i></i> Perú · Trabajo en remoto</span></p><a class="pf-text-link" href={contactUrl} target="_blank" rel="noopener noreferrer">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a></div>
    </section>
    <PortfolioFaq />
  </div>
</BaseLayout>

<script>
  // Show the static, fully styled page before initializing motion and its layout probes.
  // Navigation and contact controls are initialized separately by BaseLayout.
  requestAnimationFrame(() => requestAnimationFrame(() => {
    void Promise.all([
      import('../scripts/animations'),
      import('../scripts/portfolio'),
    ]).catch((error) => {
      delete document.documentElement.dataset.pfHero;
      console.error('No se pudo iniciar el movimiento de la portada.', error);
    });
  }));
</script>
