---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioHero from '../components/PortfolioHero.astro';
import PortfolioProcess from '../components/PortfolioProcess.astro';
import PortfolioFaq from '../components/PortfolioFaq.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PortfolioServices from '../components/PortfolioServices.astro';
import { getProjects } from '../lib/projects';
import { createContactUrl, site } from '../data/site';
import '../styles/portfolio-home.css';
import '../styles/portfolio-editorial.css';

const projectOrder = ['trama-mayorista', 'nodo-pc', 'senda-cafe', 'lume-beauty', 'nexa-digital'];
const projectRank = (slug: string) => { const rank = projectOrder.indexOf(slug); return rank < 0 ? projectOrder.length : rank; };
const projects = [...await getProjects()].sort((a, b) => projectRank(a.slug) - projectRank(b.slug));
const contactUrl = createContactUrl();
---

<BaseLayout>
  <div class="portfolio-home">
    <PortfolioHero contactUrl={contactUrl} />
    <section class="folio-section" id="proyectos" aria-labelledby="work-heading">
      <div class="folio-inner">
        <div class="folio-heading">
          <div>
            <p class="folio-kicker"><span>01</span> Proyectos seleccionados</p>
            <h2 class="folio-title" id="work-heading">El estudio <em>en acción.</em></h2>
          </div>
          <p>Prueba las demos de nuestros proyectos conceptuales: elige prendas, explora una carta o arma una PC.</p>
        </div>
        <div class="folio-grid">
          {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>
      </div>
    </section>
    <PortfolioServices />
    <PortfolioProcess />
    <section class="pf-about" id="sobre-mi" aria-labelledby="about-heading">
      <div class="pf-about-art" aria-hidden="true"><span class="pf-about-art-label">NUBICORE / ESTUDIO</span><img class="studio-seal" src="/favicon.svg" width="160" height="160" loading="lazy" alt="" /><div class="pf-about-art-bottom"><span>DISEÑO & DESARROLLO WEB</span><span>↗</span></div></div>
      <div class="pf-about-copy"><h2 class="pf-heading" id="about-heading" data-letters>El estudio<em>.</em></h2><p><strong>{site.name}</strong> es un estudio independiente de diseño y desarrollo web. Partimos de tu negocio para dar forma a una presencia digital clara, con identidad y fácil de usar.</p><p>Lo dirige <strong>{site.fullName}</strong>. Tienes trato directo con quien diseña y desarrolla tu proyecto, desde la primera conversación hasta la publicación.</p><p><span class="pf-remote"><i></i> Perú · Trabajo en remoto</span></p><a class="pf-text-link" href={contactUrl} target="_blank" rel="noopener noreferrer">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a></div>
    </section>
    <PortfolioFaq />
  </div>
</BaseLayout>

<script>
  import '../scripts/studio-home';
</script>
