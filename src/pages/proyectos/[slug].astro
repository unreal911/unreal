---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import CaseProcess from '../../components/CaseProcess.astro';
import ResponsivePreview from '../../components/ResponsivePreview.astro';
import { getProjects } from '../../lib/projects';
import { getProjectPresentation } from '../../lib/project-presentation';
import { createContactUrl, site, type Project } from '../../data/site';
import { getProjectProcess, type ProcessProjectSlug } from '../../data/process';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, nextProject: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  nextProject: Project;
}

const { project, nextProject } = Astro.props;
const presentation = getProjectPresentation(project);
const { demoUrl } = presentation;
const contactUrl = createContactUrl(`Hola, ${site.name}. Vi el proyecto ${project.title} y quiero conversar sobre una web para mi negocio.`);
const process = getProjectProcess(project.slug);
const isHardware = project.slug === 'nodo-pc';
---

<BaseLayout
  title={`${presentation.seoTitle} | ${site.name}`}
  description={presentation.seoDescription}
  breadcrumbs={[{ name: 'Inicio', path: '/' }, { name: project.title, path: `/proyectos/${project.slug}/` }]}
>
  <article class="case-page" data-project={project.slug}>
    <section class="case-hero section-pad">
      <a class="back-link" href="/#proyectos">← Volver a proyectos</a>
      <div class="case-heading">
        <div class="case-kicker"><span>{presentation.isExample ? 'PROYECTO DE EJEMPLO' : 'PROYECTO'} / {project.number}</span><span>{project.year}</span></div>
        <h1 data-letters>{project.title}<span class="case-title-dot">.</span></h1>
        <div class="case-heading-bottom"><p>{project.subtitle}</p><span>{presentation.category}</span></div>
        <p class="case-plain-summary">{presentation.description}</p>
        <div class="case-hero-actions" data-reveal>
          {demoUrl && <a class="primary-cta" href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visitar página de ${project.title} (se abre en otra pestaña)`}>Visitar página <span aria-hidden="true">↗</span></a>}
          <a class="secondary-cta" href={process ? '#proceso' : '#resultado'}>Conocer el proceso <span aria-hidden="true">↓</span></a>
        </div>
        {demoUrl && <p class="case-action-note">Se abre en otra pestaña para que puedas recorrer la página y volver aquí cuando quieras.</p>}
      </div>
    </section>

    <section class="case-artwork-wrap" aria-label={`Visual del concepto ${project.title}`}>
      <ProjectArtwork project={project} priority={true} />
    </section>

    <section class="case-overview section-pad" id="descripcion" aria-labelledby="case-overview-heading">
      <div class="case-overview-intro"><span class="section-index">(01 / EL PROYECTO)</span><h2 id="case-overview-heading" data-letters>Qué puedes<br /><em>encontrar aquí.</em></h2></div>
      <div class="case-overview-copy" data-reveal>
        <p>{presentation.description}</p>
        <div class="case-facts">
          <div><span>QUÉ INCLUYE</span><ul>{(presentation.features.length ? presentation.features : project.services).map((feature) => <li>{feature}</li>)}</ul></div>
          <div><span>PARA VER EN</span><p>Computadora, tablet y celular.</p></div>
          <div><span>{presentation.isExample ? 'EJEMPLO DE PORTAFOLIO' : 'AÑO'}</span><p>{presentation.isExample ? 'Creado para mostrar cómo podría funcionar una página para este tipo de negocio.' : project.year}</p></div>
        </div>
      </div>
    </section>

    {demoUrl && <section class="case-demo-section section-pad" id="pantallas" aria-labelledby="case-demo-heading">
      <div class="case-demo-head">
        <div><span class="section-index">(02 / ASÍ SE VE)</span><h2 id="case-demo-heading" data-letters>Tu página,<br /><em>en cada pantalla.</em></h2></div>
        <div class="case-demo-intro"><p>Elige un dispositivo para cambiar la vista de muestra. Para usar los menús y botones de la página, pulsa <strong>Visitar página</strong>.</p></div>
      </div>
      <ResponsivePreview src={demoUrl} title={project.title} />
      {isHardware && <ol class="case-pc-demo-guide" aria-label="Recorrido de la demo Nodo PC" data-reveal>
        <li><span>01 / EXPLORA</span><strong>Encuentra tu pieza.</strong><p>Filtra el catálogo y revisa los datos clave de cada componente.</p><a href="/demos/nodo-pc/componentes/" target="_blank" rel="noopener noreferrer">Ver el catálogo <span aria-hidden="true">↗</span></a></li>
        <li><span>02 / ELIGE LAS PIEZAS</span><strong>Prepara tu equipo.</strong><p>Elige las piezas de una computadora y revisa cuánto costaría.</p><a href="/demos/nodo-pc/armar/" target="_blank" rel="noopener noreferrer">Armar una computadora <span aria-hidden="true">↗</span></a></li>
        <li><span>03 / REVISA</span><strong>Todo en un pedido.</strong><p>Ajusta cantidades y prepara una selección de ejemplo para conversar sobre una web con Nubicore.</p><a href={demoUrl} target="_blank" rel="noopener noreferrer">Probar la tienda <span aria-hidden="true">↗</span></a></li>
      </ol>}
    </section>}

    {process && <CaseProcess process={process} slug={project.slug as ProcessProjectSlug} title={project.title} number={demoUrl ? '03' : '02'} />}

    <section class="case-story section-pad" id="resultado" aria-label="Resultado del proyecto">
      {process ? (
        <div class="case-story-row" data-reveal><span>04 / RESULTADO</span><h2>De la idea<br />a la pantalla.</h2><p>{project.outcome}</p></div>
      ) : (
        <>
          <div class="case-story-row" data-reveal><span>03 / EL RETO</span><h2>El punto<br />de partida.</h2><p>{project.challenge}</p></div>
          <div class="case-story-row" data-reveal><span>04 / LA DIRECCIÓN</span><h2>Dar forma<br />a la idea.</h2><p>{project.approach}</p></div>
          <div class="case-story-row" data-reveal><span>05 / EL RESULTADO</span><h2>Una nueva<br />experiencia.</h2><p>{project.outcome}</p></div>
        </>
      )}
    </section>

    <section class="case-contact section-pad" aria-labelledby="case-contact-heading">
      <div><h2 id="case-contact-heading">Una web para el siguiente paso de tu negocio.</h2><p>Cuéntanos qué necesita tu empresa y definimos juntos el alcance del proyecto.</p></div>
      <a class="primary-cta" href={contactUrl} target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp <span aria-hidden="true">↗</span></a>
    </section>

    <a class="next-project" href={`/proyectos/${nextProject.slug}/`}>
      <span>SIGUIENTE PROYECTO / {nextProject.number}</span>
      <strong>{nextProject.title}<span>↗</span></strong>
    </a>
  </article>
</BaseLayout>

<script>
  import '../../scripts/animations';
  import '../../scripts/portfolio';
</script>
