---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import CaseProcess from '../../components/CaseProcess.astro';
import ResponsivePreview from '../../components/ResponsivePreview.astro';
import '../../styles/case-overview.css';
import { getProjects } from '../../lib/projects';
import { getProjectPresentation } from '../../lib/project-presentation';
import { createContactUrl, site, type Project } from '../../data/site';
import { getProjectProcess, type ProcessProjectSlug } from '../../data/process';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, nextProject: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  nextProject: Project;
}

const { project, nextProject } = Astro.props;
const presentation = getProjectPresentation(project);
const { demoUrl } = presentation;
const offers: Record<string, { audience: string; title: string; description: string; action: string; subject: string }> = {
  'trama-mayorista': {
    audience: 'PARA NEGOCIOS DE ROPA AL POR MAYOR',
    title: 'Tu catálogo. Tus productos. Tu forma de vender.',
    description: 'Podemos diseñar un catálogo con tus prendas, mínimos de compra y una forma clara de preparar consultas por WhatsApp. Cuéntanos cuántos productos manejas y cómo recibes los pedidos hoy.',
    action: 'Cotizar mi catálogo',
    subject: 'un catálogo para mi negocio de ropa al por mayor',
  },
  'nodo-pc': {
    audience: 'PARA TIENDAS DE HARDWARE',
    title: 'Tus componentes, más fáciles de explorar.',
    description: 'Organizamos tu catálogo para que tus clientes comparen productos y preparen una cotización. Si necesitas un configurador de PC o un panel de administración, definimos esas funciones en la propuesta.',
    action: 'Cotizar mi catálogo',
    subject: 'un catálogo para mi tienda de hardware',
  },
  'lume-beauty': {
    audience: 'PARA MARCAS CON UN PRODUCTO QUE PRESENTAR',
    title: 'Dale a tu producto su propia página.',
    description: 'Podemos crear una landing para explicar tu oferta, resolver dudas y facilitar el contacto. Cuéntanos qué producto quieres presentar y qué debería hacer quien visita la página.',
    action: 'Cotizar mi landing',
    subject: 'una landing para presentar mi producto',
  },
  'nexa-digital': {
    audience: 'PARA EMPRESAS DE SERVICIOS',
    title: 'Una web que explique lo que hace tu empresa.',
    description: 'Damos un lugar claro a tus servicios, tu experiencia y el contacto. Cuéntanos qué ofrece tu empresa y qué información necesitan tus clientes antes de conversar contigo.',
    action: 'Cotizar mi web',
    subject: 'una web para mi empresa de servicios',
  },
  'senda-cafe': {
    audience: 'PARA CAFETERÍAS Y NEGOCIOS GASTRONÓMICOS',
    title: 'Tu carta y tu espacio, a un enlace.',
    description: 'Podemos crear una web para mostrar tu carta, contar tu historia y facilitar las consultas sobre una visita. Cuéntanos qué necesitas presentar y cómo te contactan tus clientes.',
    action: 'Cotizar mi web',
    subject: 'una web para mi cafetería o negocio gastronómico',
  },
};
const offer = offers[project.slug] ?? {
  audience: 'UNA WEB PARA TU NEGOCIO',
  title: 'Una web para el siguiente paso de tu negocio.',
  description: 'Cuéntanos qué necesita tu empresa y definimos juntos el alcance del proyecto.',
  action: 'Cotizar mi web',
  subject: 'una web para mi negocio',
};
const contactUrl = createContactUrl(`Hola, ${site.name}. Vi el proyecto ${project.title} y quiero cotizar ${offer.subject}.`);
const process = getProjectProcess(project.slug);
const isHardware = project.slug === 'nodo-pc';
---

<BaseLayout
  title={`${presentation.seoTitle} | ${site.name}`}
  description={presentation.seoDescription}
  breadcrumbs={[{ name: 'Inicio', path: '/' }, { name: project.title, path: `/proyectos/${project.slug}/` }]}
>
  <article class="case-page" data-project={project.slug}>
    <section class="case-hero section-pad">
      <a class="back-link" href="/#proyectos">← Volver a proyectos</a>
      <div class="case-heading">
        <div class="case-kicker"><span>{presentation.isExample ? 'PROYECTO DE EJEMPLO' : 'PROYECTO'} / {project.number}</span><span>{project.year}</span></div>
        <h1 data-letters>{project.title}<span class="case-title-dot">.</span></h1>
        <div class="case-heading-bottom"><p>{project.subtitle}</p><span>{presentation.category}</span></div>
        <p class="case-plain-summary">{presentation.description}</p>
        <div class="case-hero-actions" data-reveal>
          {demoUrl && <a class="primary-cta" href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visitar página de ${project.title} (se abre en otra pestaña)`}>Visitar página <span aria-hidden="true">↗</span></a>}
          <a class="secondary-cta" href={contactUrl} target="_blank" rel="noopener noreferrer" aria-label={`${offer.action} por WhatsApp`}>{offer.action} <span aria-hidden="true">↗</span></a>
          <a class="case-process-link" href={process ? '#proceso' : '#resultado'}>Conocer el proceso <span aria-hidden="true">↓</span></a>
        </div>
        {demoUrl && <p class="case-action-note">Se abre en otra pestaña para que puedas recorrer la página y volver aquí cuando quieras.</p>}
      </div>
    </section>

    <section class="case-artwork-wrap" aria-label={`Visual del concepto ${project.title}`}>
      <ProjectArtwork project={project} priority={true} />
    </section>

    <section class="case-overview section-pad" id="descripcion" aria-labelledby="case-overview-heading">
      <header class="case-overview-heading">
        <div><span class="section-index">(01 / EL PROYECTO)</span><h2 id="case-overview-heading">Qué puedes<br /><em>encontrar aquí.</em></h2></div>
        <p>{presentation.overview}</p>
      </header>
      <ol class="case-overview-features" aria-label={`Qué ofrece la página de ${project.title}`}>
        {presentation.features.map((feature, index) => <li>
          <span class="case-feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{feature.title}</h3>
          {feature.description && <p>{feature.description}</p>}
        </li>)}
      </ol>
      <div class="case-overview-footnote">
        <p><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="4" width="14" height="11" rx="1.5"/><path d="M5 19h8m-4-4v4"/><rect x="17" y="10" width="5" height="10" rx="1"/></svg>Para computadora, tablet y celular.</p>
        <p>{presentation.isExample ? 'Proyecto de ejemplo para explorar y probar.' : `Realizado en ${project.year}.`}</p>
      </div>
    </section>

    {demoUrl && <section class="case-demo-section section-pad" id="pantallas" aria-labelledby="case-demo-heading">
      <div class="case-demo-head">
        <div><span class="section-index">(02 / ASÍ SE VE)</span><h2 id="case-demo-heading" data-letters>Tu página,<br /><em>en cada pantalla.</em></h2></div>
        <div class="case-demo-intro"><p>Elige un dispositivo para cambiar la vista de muestra. Para usar los menús y botones de la página, pulsa <strong>Visitar página</strong>.</p></div>
      </div>
      <ResponsivePreview src={demoUrl} title={project.title} />
      {isHardware && <ol class="case-pc-demo-guide" aria-label="Recorrido de la demo Nodo PC" data-reveal>
        <li><span>01 / EXPLORA</span><strong>Encuentra tu pieza.</strong><p>Filtra el catálogo y revisa los datos clave de cada componente.</p><a href="/demos/nodo-pc/componentes/" target="_blank" rel="noopener noreferrer">Ver el catálogo <span aria-hidden="true">↗</span></a></li>
        <li><span>02 / ELIGE LAS PIEZAS</span><strong>Prepara tu equipo.</strong><p>Elige las piezas de una computadora y revisa cuánto costaría.</p><a href="/demos/nodo-pc/armar/" target="_blank" rel="noopener noreferrer">Armar una computadora <span aria-hidden="true">↗</span></a></li>
        <li><span>03 / REVISA</span><strong>Todo en un pedido.</strong><p>Ajusta cantidades y prepara una selección de ejemplo para conversar sobre una web con Nubicore.</p><a href={demoUrl} target="_blank" rel="noopener noreferrer">Probar la tienda <span aria-hidden="true">↗</span></a></li>
      </ol>}
    </section>}

    {process && <CaseProcess process={process} slug={project.slug as ProcessProjectSlug} title={project.title} number={demoUrl ? '03' : '02'} />}

    <section class="case-story section-pad" id="resultado" aria-label="Resultado del proyecto">
      {process ? (
        <div class="case-story-row" data-reveal><span>04 / RESULTADO</span><h2>De la idea<br />a la pantalla.</h2><p>{project.outcome}</p></div>
      ) : (
        <>
          <div class="case-story-row" data-reveal><span>03 / EL RETO</span><h2>El punto<br />de partida.</h2><p>{project.challenge}</p></div>
          <div class="case-story-row" data-reveal><span>04 / LA DIRECCIÓN</span><h2>Dar forma<br />a la idea.</h2><p>{project.approach}</p></div>
          <div class="case-story-row" data-reveal><span>05 / EL RESULTADO</span><h2>Una nueva<br />experiencia.</h2><p>{project.outcome}</p></div>
        </>
      )}
    </section>

    <section class="case-contact section-pad" aria-labelledby="case-contact-heading">
      <div><span class="case-offer-audience">{offer.audience}</span><h2 id="case-contact-heading">{offer.title}</h2><p>{offer.description}</p></div>
      <a class="primary-cta" href={contactUrl} target="_blank" rel="noopener noreferrer" aria-label={`${offer.action} por WhatsApp`}>{offer.action} <span aria-hidden="true">↗</span></a>
    </section>

    <a class="next-project" href={`/proyectos/${nextProject.slug}/`}>
      <span>SIGUIENTE PROYECTO / {nextProject.number}</span>
      <strong>{nextProject.title}<span>↗</span></strong>
    </a>
  </article>
</BaseLayout>

<style>
  .case-process-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; padding: 12px 6px; font-size: 13px; color: var(--muted); text-decoration: underline; text-underline-offset: 5px; }
  .case-process-link:hover { color: var(--ink); }
  .case-offer-audience { display: block; margin-bottom: 18px; color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .08em; line-height: 1.6; }
  .case-contact p { max-width: 680px; }
  @media (max-width: 540px) { .case-process-link { justify-self: start; } }
</style>

<script>
  import '../../scripts/animations';
  import '../../scripts/portfolio';
</script>
