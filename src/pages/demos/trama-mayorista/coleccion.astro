---
import TramaLayout from '../../../layouts/TramaLayout.astro';
import TramaCatalogCard from '../../../components/TramaCatalogCard.astro';
import { products } from '../../../data/trama';
import { tramaSupabaseConfigured } from '../../../lib/trama-supabase';

const initialProducts = tramaSupabaseConfigured ? [] : products;
const count = initialProducts.length;
---

<TramaLayout
  title="La colección — Trama Mayorista"
  description="Explora la colección de Trama Mayorista y reparte las cantidades por talla y color. Prepara un pedido de demostración desde seis prendas combinadas."
  currentPage="coleccion"
>
  <section class="trama-page-intro section-wrap" aria-labelledby="collection-page-title">
    <nav class="trama-breadcrumbs" aria-label="Ruta de navegación">
      <a href="/demos/trama-mayorista/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">La colección</span>
    </nav>
    <p class="eyebrow">LA COLECCIÓN / 01</p>
    <h1 id="collection-page-title">Prendas para tu próxima colección.</h1>
    <p>Elige una prenda y reparte las cantidades entre sus tallas y colores. Combina tus favoritos en un pedido desde 6 prendas.</p>
  </section>

  <section class="catalog section-wrap" id="coleccion" aria-labelledby="catalog-title">
    <h2 id="catalog-title" class="sr-only">Prendas disponibles</h2>
    <div class="catalog-tools">
      <div class="category-tabs" role="group" aria-label="Filtrar colección por categoría">
        <button type="button" data-category="all" aria-pressed="true">Todo <span id="trama-catalog-total">{count ? String(count).padStart(2, '0') : ''}</span></button>
        <button type="button" data-category="polos" aria-pressed="false">Polos</button>
        <button type="button" data-category="camisas" aria-pressed="false">Camisas</button>
        <button type="button" data-category="abrigos" aria-pressed="false">Abrigos</button>
        <button type="button" data-category="pantalones" aria-pressed="false">Pantalones</button>
      </div>
      <label class="catalog-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
        <span class="sr-only">Buscar prendas</span>
        <input type="search" id="trama-search" placeholder="Encuentra tu próximo favorito" />
      </label>
    </div>
    <div class="catalog-meta">
      <p id="result-count" role="status">{tramaSupabaseConfigured ? 'Cargando la colección…' : `${count} productos`}</p>
      <label>Ordenar por <select id="trama-sort"><option value="featured">Destacados</option><option value="price-asc">Menor precio</option><option value="price-desc">Mayor precio</option></select></label>
    </div>
    <div class="product-grid" id="product-grid" aria-busy={tramaSupabaseConfigured ? 'true' : undefined}>
      {initialProducts.map((product, index) => <TramaCatalogCard product={product} index={index} />)}
    </div>
    {tramaSupabaseConfigured && <template id="trama-card-template"><TramaCatalogCard product={products[0]} index={0} /></template>}
    <div id="catalog-empty" class="catalog-empty" hidden><span aria-hidden="true">⌕</span><h3>No encontramos esa combinación.</h3><p>Prueba con otro nombre o cambia la categoría.</p></div>
    <p class="catalog-note">Precios de muestra por prenda para pedidos de 6 a 23 unidades. Desde 24 prendas se aplica un 10% de descuento; desde 48, un 15%. Puedes combinar modelos, tallas y colores. Las fotografías son referenciales.</p>
  </section>

  <section class="trama-next-section section-wrap" aria-labelledby="next-section-title">
    <div><p class="eyebrow">EL PRECIO TAMBIÉN IMPORTA</p><h2 id="next-section-title">Tu pedido crece. Tu precio mejora.</h2></div>
    <a class="trama-button" href="/demos/trama-mayorista/mayoristas/">Conoce los precios por volumen <span aria-hidden="true">↗</span></a>
  </section>
</TramaLayout>
