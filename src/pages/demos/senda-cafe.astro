---
import '../../styles/demo-cafe.css';
import { createContactUrl, site } from '../../data/site';
const designerWhatsapp = createContactUrl(`Hola, ${site.name}. Vi el proyecto Senda Café y me gustaría conversar sobre una web para mi negocio.`);
const specialties = [
  { name: 'Espresso de origen', note: 'Pequeño en tamaño. Inmenso en carácter.', image: 'espresso.jpg', price: '9', label: 'EL ESENCIAL', number: '01' },
  { name: 'Latte de la casa', note: 'La suavidad también tiene personalidad.', image: 'latte.jpg', price: '14', label: 'EL FAVORITO', number: '02' },
  { name: 'Cold brew', note: 'Doce horas de paciencia. Un sorbo de frescura.', image: 'cold-brew.jpg', price: '13', label: 'SIN PRISA, SIN CALOR', number: '03' },
];
const menu = [
  { name: 'Espresso', detail: 'Doble extracción · cacao y panela', price: '9', category: 'cafe', image: 'espresso.jpg' },
  { name: 'Americano', detail: 'Espresso de la casa · agua caliente', price: '10', category: 'cafe', image: 'espresso.jpg' },
  { name: 'Cappuccino', detail: 'Espresso · leche texturizada · equilibrio', price: '13', category: 'cafe', image: 'latte.jpg' },
  { name: 'Latte de avena', detail: 'Doble espresso · bebida de avena', price: '15', category: 'cafe', image: 'latte.jpg' },
  { name: 'Flat white', detail: 'Doble ristretto · microespuma de leche', price: '14', category: 'cafe', image: 'latte.jpg' },
  { name: 'Filtrado del día', detail: 'Pregunta por el origen y el método', price: '16', category: 'cafe', image: 'story-barista.jpg' },
  { name: 'Cold brew', detail: 'Extracción en frío · suave y refrescante', price: '13', category: 'frios', image: 'cold-brew.jpg' },
  { name: 'Iced latte', detail: 'Espresso · leche fresca · hielo', price: '15', category: 'frios', image: 'cold-brew.jpg' },
  { name: 'Espresso tonic', detail: 'Doble espresso · tónica · naranja', price: '17', category: 'frios', image: 'cold-brew.jpg' },
  { name: 'Latte de vainilla frío', detail: 'Espresso · vainilla · leche · hielo', price: '17', category: 'frios', image: 'cold-brew.jpg' },
  { name: 'Croissant de mantequilla', detail: 'Hojaldre dorado · recién horneado', price: '11', category: 'cocina', image: 'pastry.jpg' },
  { name: 'Tostada de palta', detail: 'Masa madre · palta · semillas', price: '22', category: 'cocina', image: 'pastry.jpg' },
  { name: 'Croissant de la casa', detail: 'Queso andino · tomate · albahaca', price: '19', category: 'cocina', image: 'pastry.jpg' },
  { name: 'Dulce del día', detail: 'Una pequeña razón para quedarte', price: '14', category: 'cocina', image: 'pastry.jpg' },
];
const gallery = [
  { image: 'interior.jpg', alt: 'Un espacio de café cálido con mesas y luz natural', title: 'Tu mesa de siempre', category: 'EL ESPACIO' },
  { image: 'story-barista.jpg', alt: 'Preparación artesanal de café en la barra', title: 'Detrás de cada taza', category: 'LA BARRA' },
  { image: 'pastry.jpg', alt: 'Pastelería para acompañar una taza de café', title: 'Un pequeño antojo', category: 'EL ACOMPAÑANTE' },
  { image: 'latte.jpg', alt: 'Café con leche y arte latte', title: 'El último detalle', category: 'EL RITUAL' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171b17" />
    <meta name="description" content={`Senda Café. Café de origen, cocina de temporada y tiempo para disfrutar. Una experiencia web conceptual de ${site.name}.`} />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="Senda Café — Las cosas buenas toman su tiempo" />
    <meta property="og:description" content={`Café de especialidad y momentos sin prisa. Proyecto conceptual de ${site.name}.`} />
    <meta property="og:image" content="/images/senda/hero-coffee.webp" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/images/senda/hero-coffee.webp" />
    <title>Senda Café — Las cosas buenas toman su tiempo</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="cafe-demo" id="inicio">
      <div class="concept-bar"><a href="/proyectos/senda-cafe/">↖ Volver al portafolio</a><span>UNA CAFETERÍA IMAGINADA. UNA EXPERIENCIA REAL.</span><span>DEMO CONCEPTUAL · 2026</span></div>
      <header class="cafe-header" data-cafe-header>
        <a class="cafe-brand" href="#inicio" aria-label="Senda Café, inicio"><span>senda<span class="brand-dot">.</span></span><small>CAFÉ & BUENOS MOMENTOS</small></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="cafe-navigation"><span></span><span></span><span class="sr-only">Abrir menú</span></button>
        <nav id="cafe-navigation" class="cafe-navigation" aria-label="Navegación principal"><a href="#historia">Nuestra esencia</a><a href="#especialidades">Especialidades</a><a href="#carta">La carta</a><a href="#espacio">El espacio</a><a class="nav-reserve" href="#reserva">Una mesa para ti <span aria-hidden="true">↗</span></a></nav>
      </header>
      <main id="contenido">
        <section class="cafe-hero" aria-labelledby="hero-title">
          <div class="hero-images" aria-hidden="true"><img class="hero-image is-active" src="/images/senda/hero-coffee.webp" alt="" width="1672" height="941" fetchpriority="high" data-hero-image /><img class="hero-image" src="/images/senda/interior.jpg" alt="" width="1500" height="1028" loading="lazy" data-hero-image /><img class="hero-image" src="/images/senda/story-barista.jpg" alt="" width="1000" height="1500" loading="lazy" data-hero-image /></div>
          <div class="hero-shade"></div>
          <div class="hero-content"><p class="eyebrow hero-eyebrow"><span></span> CAFÉ DE ESPECIALIDAD · ALMA PERUANA</p><h1 id="hero-title"><span>Las cosas buenas</span><span>toman <em>su tiempo.</em></span></h1><p class="hero-description">Un buen café. Una conversación que se alarga.<br />Un lugar para volver a disfrutar lo simple.</p><div class="hero-actions"><a class="cafe-button button-copper" href="#carta">Explora la carta <span aria-hidden="true">↗</span></a><a class="text-link" href="#historia">El mundo Senda <span aria-hidden="true">↓</span></a></div></div>
          <div class="hero-bottom"><a class="hero-scroll" href="#historia"><span class="scroll-line"></span> DESLIZA Y QUÉDATE UN RATO</a><div class="hero-slider" role="group" aria-label="Fotografías de Senda"><button type="button" data-hero-prev aria-label="Fotografía anterior">←</button><span data-hero-counter aria-live="polite">01 <i>/ 03</i></span><button type="button" data-hero-next aria-label="Siguiente fotografía">→</button></div></div>
          <a class="hero-seal" href="#origen" aria-label="Descubre nuestro café de origen"><svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id="seal-path" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs><text><textPath href="#seal-path" textLength="272">CAFÉ CON ORIGEN · HECHO CON CALMA · </textPath></text></svg><span aria-hidden="true">✳</span></a>
        </section>
        <div class="senda-promises"><p><span aria-hidden="true">✳</span> Origen que se siente<small>GRANOS CON IDENTIDAD</small></p><p><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M9 16h21v9a10.5 10.5 0 0 1-21 0v-9Zm21 2h3a5 5 0 0 1 0 10h-4M6 36h28M16 10c-5-5 4-5 0-10m9 10c-5-5 4-5 0-10" stroke="currentColor" stroke-width="1.5"/></svg> Preparado con intención<small>EL CUIDADO ESTÁ EN LOS DETALLES</small></p><p><span aria-hidden="true">☼</span> Aquí, el tiempo es tuyo<small>ENTRA. RESPIRA. DISFRUTA.</small></p></div>
        <section class="story-section section-space section-inset" id="historia" aria-labelledby="story-title">
          <div class="story-collage" data-reveal><div class="story-main-image image-reveal"><img src="/images/senda/story-barista.jpg" alt="El cuidado de preparar una taza de café a mano" width="1000" height="1500" loading="lazy" /></div><div class="story-small-image"><img src="/images/senda/interior.jpg" alt="Un rincón acogedor para hacer una pausa" width="1500" height="1028" loading="lazy" /><span>EL ARTE DE QUEDARSE.</span></div><span class="story-image-note">SENDA / EL CAFÉ ES SOLO EL COMIENZO</span></div>
          <div class="story-copy" data-reveal><p class="eyebrow"><span class="mini-star">✳</span> NUESTRA ESENCIA</p><h2 id="story-title">Hay lugares.<br />Y hay lugares que<br /><em>se sienten.</em></h2><p class="lead">Senda nace de una idea sencilla: hacerle un espacio a las cosas que valen la pena.</p><p>El aroma del café recién molido, el primer bocado de algo rico, una mesa compartida. Imaginamos un refugio cotidiano donde cada taza tenga origen y cada visita, su propio ritmo.</p><div class="story-signature"><span>Nos vemos en Senda.</span><svg viewBox="0 0 65 65" fill="none" aria-hidden="true"><path d="M14 46C2 25 29 4 45 13c24 13-3 49-20 40-12-6 12-38 26-43M10 54C27 41 36 30 50 15" stroke="currentColor" stroke-width="1.2"/></svg></div><a class="text-link dark-link" href="#origen">Del origen a tu taza <span aria-hidden="true">↗</span></a></div>
        </section>
        <section class="specialties-section section-space section-inset" id="especialidades" aria-labelledby="specialties-title">
          <div class="section-heading" data-reveal><div><p class="eyebrow"><span class="mini-star">✳</span> PEQUEÑOS GRANDES RITUALES</p><h2 id="specialties-title">Encuentra <em>tu favorito.</em></h2></div><p>Hay una taza para cada forma de vivir el día.<br />Estas son las nuestras.</p></div>
          <div class="specialties-grid">{specialties.map((item) => <a class="specialty-card" href="#carta" data-menu-shortcut={item.number === '03' ? 'frios' : 'cafe'} data-reveal><div class="specialty-image"><img src={`/images/senda/${item.image}`} alt={item.name} width="900" height="1000" loading="lazy" /><span class="specialty-label">{item.label}</span><span class="specialty-discover" aria-hidden="true">↗</span></div><div class="specialty-info"><span class="specialty-number">{item.number} /</span><div><h3>{item.name}</h3><p>{item.note}</p></div><span class="specialty-price"><small>S/</small> {item.price}</span></div></a>)}</div>
          <div class="specialties-bottom"><span>BUEN CAFÉ. NADA MÁS. NADA MENOS.</span><a class="text-link" href="#carta">Toda la carta <span aria-hidden="true">↗</span></a></div>
        </section>
        <div class="coffee-marquee" aria-hidden="true"><div><span>Un sorbo de calma</span><i>✳</i><span>Un poco de Senda</span><i>✳</i><span>Un sorbo de calma</span><i>✳</i><span>Un poco de Senda</span><i>✳</i></div></div>
        <section class="menu-section section-space section-inset" id="carta" aria-labelledby="menu-title">
          <div class="center-heading" data-reveal><p class="eyebrow"><span class="mini-star">✳</span> NUESTRA CARTA</p><h2 id="menu-title">A tu gusto.<br /><em>A tu ritmo.</em></h2><p>Café que acompaña. Sabores que se quedan.</p></div>
          <div class="menu-filters" role="group" aria-label="Filtrar la carta"><button type="button" class="is-active" data-menu-filter="cafe" aria-pressed="true">Café de especialidad <span>06</span></button><button type="button" data-menu-filter="frios" aria-pressed="false">Algo fresco <span>04</span></button><button type="button" data-menu-filter="cocina" aria-pressed="false">De la cocina <span>04</span></button><button type="button" data-menu-filter="todo" aria-pressed="false">Ver todo <span>14</span></button></div>
          <div class="menu-items" aria-live="polite">{menu.map((item) => <article class="menu-item" data-menu-category={item.category} hidden={item.category !== 'cafe'}><img src={`/images/senda/${item.image}`} alt="" width="80" height="80" loading="lazy" /><div class="menu-item-copy"><div class="menu-item-top"><h3>{item.name}</h3><span class="menu-dots"></span><span class="menu-price">S/ {item.price}</span></div><p>{item.detail}</p></div></article>)}</div>
          <div class="menu-footnote"><span>¿Leche de avena? Claro que sí. Pregunta por las opciones vegetales.</span><small>Carta y precios referenciales de este concepto.</small></div>
        </section>
        <section class="origin-banner" aria-labelledby="origin-banner-title"><img src="/images/senda/coffee-beans.jpg" alt="Textura de granos de café tostado" width="1000" height="763" loading="lazy" data-parallax /><div class="origin-banner-shade"></div><div data-reveal><p class="eyebrow">DE LA TIERRA A LA TAZA</p><h2 id="origin-banner-title">El mejor ingrediente<br />es <em>el cuidado.</em></h2><p>Detrás de un buen café hay un camino que merece ser contado.</p></div><span class="origin-banner-corner">ORIGEN PERUANO / CARÁCTER PROPIO</span></section>
        <section class="origin-section section-space section-inset" id="origen" aria-labelledby="origin-title"><div class="origin-intro" data-reveal><p class="eyebrow"><span class="mini-star">✳</span> EL CAMINO SENDA</p><h2 id="origin-title">Una buena taza<br />empieza <em>mucho antes.</em></h2><p>Nos inspira la riqueza del café peruano. Un ritual que conecta la tierra, las manos que la trabajan y el momento en que llega a ti.</p><a class="text-link dark-link" href="#reserva">Vive el ritual <span aria-hidden="true">↗</span></a></div><div class="origin-steps" data-reveal><details open><summary><span>01</span><h3>El origen importa</h3><i aria-hidden="true">+</i></summary><p>Granos con identidad, cultivados en tierras de altura. La propuesta de Senda celebra perfiles peruanos con notas de cacao, frutos y panela.</p></details><details><summary><span>02</span><h3>Tostar para descubrir</h3><i aria-hidden="true">+</i></summary><p>Un tueste que acompaña al grano y deja hablar a sus matices. Buscamos dulzor, balance y una taza que invite al siguiente sorbo.</p></details><details><summary><span>03</span><h3>Preparar con intención</h3><i aria-hidden="true">+</i></summary><p>Molienda, agua, temperatura y tiempo. Pequeños ajustes que transforman la preparación en un oficio y cada café en una experiencia.</p></details></div></section>
        <section class="gallery-section section-space" id="espacio" aria-labelledby="gallery-title"><div class="section-heading section-inset" data-reveal><div><p class="eyebrow"><span class="mini-star">✳</span> UN LUGAR PARA ESTAR</p><h2 id="gallery-title">Tu pausa tiene <em>un lugar.</em></h2></div><p>Luz cálida, café recién hecho<br />y esa sensación de estar a gusto.</p></div><div class="gallery-grid">{gallery.map((item, index) => <button type="button" class={`gallery-item gallery-item-${index + 1}`} data-gallery-src={`/images/senda/${item.image}`} data-gallery-caption={item.title} aria-label={`Ampliar imagen: ${item.title}`} data-reveal><img src={`/images/senda/${item.image}`} alt={item.alt} width="900" height="1100" loading="lazy" /><span class="gallery-overlay"><small>{item.category}</small><span>{item.title}</span><i aria-hidden="true">↗</i></span></button>)}</div><p class="gallery-note section-inset">Un moodboard del universo Senda. Imágenes de ambiente para este proyecto conceptual.</p></section>
        <section class="reservation-section" id="reserva" aria-labelledby="reservation-title"><div class="reservation-image"><img src="/images/senda/interior.jpg" alt="Mesas de cafetería iluminadas con luz cálida" width="1500" height="1028" loading="lazy" /><div><p class="eyebrow">EL MEJOR PLAN ES SIN PRISA</p><p>Te guardamos<br /><em>un momento.</em></p><span>SENDA CAFÉ / LIMA, PERÚ</span></div></div><div class="reservation-content" data-reveal><p class="eyebrow"><span class="mini-star">✳</span> NOS VEMOS EN SENDA</p><h2 id="reservation-title">Una mesa.<br /><em>Mil conversaciones.</em></h2><p>Ven con tu persona favorita, con un buen libro o simplemente contigo.</p><form class="reservation-form" data-reservation-form><label class="field-full">Tu nombre<input type="text" name="name" placeholder="¿Cómo te llamas?" autocomplete="given-name" maxlength="80" required /></label><label>El día<input type="date" name="date" required /></label><label>La hora<select name="time" required><option value="">Elige una hora</option>{['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00'].map(time => <option value={time}>{time}</option>)}</select></label><label class="field-full">La compañía<select name="guests"><option value="1">Solo yo y un buen café</option><option value="2" selected>Una mesa para dos</option><option value="3">Somos tres</option><option value="4">Somos cuatro</option><option value="5">Somos cinco</option><option value="6">Somos seis</option></select></label><button class="cafe-button button-copper field-full" type="submit">Probar reserva <span aria-hidden="true">↗</span></button><p class="reservation-disclaimer field-full">Esta es una demo. Tu prueba no crea una reserva ni envía tus datos.</p></form><div class="reservation-result" data-reservation-result role="status" tabindex="-1" hidden><span aria-hidden="true">✳</span><h3>Así empieza una buena pausa.</h3><p data-reservation-summary></p><small>Prueba completada. No se ha registrado una reserva real.</small><button type="button" class="text-link" data-reservation-reset>Volver a probar <span aria-hidden="true">↗</span></button></div></div></section>
        <section class="visit-section section-inset" aria-label="Visita Senda"><div><span class="eyebrow">ENCUÉNTRANOS</span><h3>En el corazón de <em>Barranco.</em></h3><p>Lima, Perú · Ubicación referencial del concepto</p><a class="text-link dark-link" href="https://www.google.com/maps/search/?api=1&query=Barranco%2C+Lima%2C+Peru" target="_blank" rel="noopener noreferrer">Explora el barrio <span aria-hidden="true">↗</span></a></div><div><span class="eyebrow">SIEMPRE ES UN BUEN MOMENTO</span><dl><div><dt>Lunes a viernes</dt><dd>8:00 — 20:00</dd></div><div><dt>Sábados y domingos</dt><dd>9:00 — 20:00</dd></div></dl><small>Horarios ilustrativos para esta demo.</small></div><a class="visit-top" href="#inicio" aria-label="Volver al inicio">↑</a></section>
      </main>
      <footer class="cafe-footer section-inset"><div class="footer-top"><p>Buen café.<br /><em>Mejores momentos.</em></p><nav aria-label="Navegación de pie de página"><a href="#historia">Nuestra esencia</a><a href="#carta">La carta</a><a href="#espacio">El espacio</a><a href="#reserva">Una mesa para ti ↗</a></nav><div class="footer-note"><span>UN CONCEPTO DE CAFETERÍA<br />CON MUCHO POR COMPARTIR.</span><span>CAFÉ DE ORIGEN<br />LIMA, PERÚ</span></div></div><a class="footer-wordmark" href="#inicio" aria-label="Senda Café, volver al inicio">senda<span>.</span><i aria-hidden="true">✳</i></a><div class="footer-bottom"><span>© 2026 SENDA CAFÉ · PROYECTO CONCEPTUAL</span><a href="/proyectos/senda-cafe/">DISEÑO & DESARROLLO POR {site.name.toUpperCase()} ↗</a></div></footer>
      <a class="designer-cta" href={designerWhatsapp} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span><span>¿Una web así para tu marca?<strong>Hablemos por WhatsApp</strong></span></a>
      <dialog class="gallery-dialog" data-gallery-dialog aria-label="Galería de Senda"><button type="button" class="gallery-close" data-gallery-close aria-label="Cerrar imagen">×</button><figure><img alt="" data-gallery-image /><figcaption data-gallery-caption></figcaption></figure><div class="gallery-dialog-controls"><button type="button" data-gallery-prev aria-label="Imagen anterior">←</button><span data-gallery-count></span><button type="button" data-gallery-next aria-label="Siguiente imagen">→</button></div></dialog>
    </div>
    <script src="../../scripts/senda-cafe.ts"></script>
  </body>
</html>
