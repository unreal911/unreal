---
import '../../styles/demo-beauty.css';
import { createContactUrl, site } from '../../data/site';
const designerWhatsapp = createContactUrl(`Hola, ${site.name}. Vi el proyecto Lumé Beauty y quiero conversar sobre una web para mi negocio.`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e8d5dd" />
    <meta name="description" content={`Lumé Beauty: una experiencia conceptual de cuidado personal diseñada y desarrollada por ${site.name}.`} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Italiana&display=swap" rel="stylesheet" />
    <title>Lumé Beauty — Una belleza en su propia luz</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="lume-page">
      <header class="lume-masthead">
        <nav class="masthead-nav" aria-label="Navegación de Lumé Beauty">
          <div class="masthead-links masthead-left">
            <a class="case-link" href="/proyectos/lume-beauty/">← Volver al caso</a>
            <a class="desktop-link" href="#filosofia">Filosofía</a>
          </div>
          <a class="brand" href="#inicio" aria-label="Lumé Beauty, volver al inicio">lumé<span>.</span></a>
          <div class="masthead-links masthead-right">
            <a class="desktop-link" href="#producto">El sérum</a>
            <a class="desktop-link" href="#ritual">Ritual</a>
            <a class="contact-link" href={designerWhatsapp} target="_blank" rel="noopener noreferrer">{site.name} ↗</a>
          </div>
        </nav>
      </header>

      <main id="contenido">
        <section class="hero" id="inicio" aria-labelledby="hero-title">
          <div class="hero-scene" aria-label="Ilustración conceptual de un envase de sérum Lumé Beauty">
            <div class="hero-overline" data-hero-reveal><span>PROYECTO CONCEPTUAL / 2026</span><span>CUIDADO PERSONAL, A TU RITMO</span></div>
            <span class="scene-halo halo-one" aria-hidden="true"></span>
            <span class="scene-halo halo-two" aria-hidden="true"></span>
            <span class="scene-petal petal-one" aria-hidden="true"></span>
            <span class="scene-petal petal-two" aria-hidden="true"></span>
            <span class="scene-petal petal-three" aria-hidden="true"></span>
            <span class="scene-orb" aria-hidden="true"></span>
            <h1 id="hero-title" data-hero-reveal><span>Tu piel,</span><em>tu luz.</em></h1>
            <div class="product-bottle bottle-hero" aria-hidden="true">
              <div class="bottle-cap"></div>
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-glint"></div>
                <div class="bottle-label"><span>lumé<span class="bottle-dot">.</span></span><small>THE GLOW SERUM</small><i>30 ml / 1.0 fl oz</i></div>
              </div>
            </div>
            <span class="hero-side-note" aria-hidden="true">BELLEZA EN SU PROPIA LUZ · 01 / 03</span>
            <div class="hero-bottom">
              <p class="hero-lede" data-hero-reveal>Un pequeño ritual para detener el tiempo, conectar contigo y dejar que tu brillo natural hable.</p>
              <div class="hero-actions" data-hero-reveal>
                <a class="underlined-link" href="#filosofia">La filosofía <span aria-hidden="true">↓</span></a>
                <a class="button button-dark" href="#producto">Conoce el sérum <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
        </section>

        <div class="promise-strip" aria-label="Valores de Lumé Beauty">
          <span>UNA PAUSA PARA TI</span><span aria-hidden="true">✳</span><span>UNA PIEL QUE SE SIENTE BIEN</span><span aria-hidden="true">✳</span><span>UNA LUZ MUY TUYA</span>
        </div>

        <section class="philosophy section-wrap" id="filosofia" aria-labelledby="philosophy-title">
          <div class="section-topline" data-lume-reveal><span>01 / NUESTRA FILOSOFÍA</span><span>BEAUTY IN YOUR OWN LIGHT</span></div>
          <div class="philosophy-grid">
            <div class="philosophy-display" data-lume-reveal><span class="outline-flower" aria-hidden="true">✳</span><p>Belleza que empieza <em>contigo.</em></p></div>
            <div class="philosophy-copy" data-lume-reveal>
              <span class="section-kicker">EL PLACER DE LO SIMPLE</span>
              <h2 id="philosophy-title">Un momento para volver a ti.</h2>
              <p>Creemos en las rutinas que hacen espacio para sentir. Lumé imagina el cuidado de la piel como una pausa diaria, sencilla y personal.</p>
              <a class="underlined-link" href="#ritual">Conoce el ritual <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>

        <section class="product-section" id="producto" aria-labelledby="product-title">
          <div class="product-scene" data-lume-reveal aria-label="Ilustración conceptual del sérum Lumé Beauty sobre fondo color arena">
            <span class="product-sun" aria-hidden="true"></span>
            <span class="product-pedestal" aria-hidden="true"></span>
            <span class="product-spark spark-a" aria-hidden="true">✳</span>
            <span class="product-spark spark-b" aria-hidden="true">✳</span>
            <div class="product-bottle bottle-feature" aria-hidden="true">
              <div class="bottle-cap"></div>
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-glint"></div>
                <div class="bottle-label"><span>lumé<span class="bottle-dot">.</span></span><small>THE GLOW SERUM</small><i>30 ml / 1.0 fl oz</i></div>
              </div>
            </div>
            <span class="product-scene-label">YOUR DAILY GLOW / 001</span>
          </div>
          <div class="product-copy" data-lume-reveal>
            <span class="section-kicker">02 / EL PRODUCTO</span>
            <h2 id="product-title">Tu pausa. <em>Tu glow.</em></h2>
            <p class="product-intro">The Glow Serum es el protagonista de esta experiencia conceptual: una invitación a convertir el cuidado diario en un momento que también se disfruta.</p>
            <div class="product-detail"><span>01</span><div><h3>Un gesto sencillo</h3><p>Una rutina fácil de incorporar a tus mañanas o noches.</p></div></div>
            <div class="product-detail"><span>02</span><div><h3>Un diseño sensorial</h3><p>Texturas, color y calma reunidos en una experiencia.</p></div></div>
            <div class="product-detail"><span>03</span><div><h3>Todo a tu manera</h3><p>Porque cada piel y cada ritual tienen su propio ritmo.</p></div></div>
            <a class="button button-plum" href="#ritual">Descubre cómo usarlo <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="ritual section-wrap" id="ritual" aria-labelledby="ritual-title">
          <div class="section-topline" data-lume-reveal><span>03 / EL RITUAL</span><span>UN MOMENTO QUE ES TUYO</span></div>
          <div class="ritual-heading" data-lume-reveal><h2 id="ritual-title">Lo esencial, <em>sin prisa.</em></h2><p>Tres pequeños gestos para hacer del cuidado personal un momento consciente.</p></div>
          <div class="ritual-steps">
            <article class="ritual-step" data-lume-reveal><span class="step-number">01</span><div class="step-symbol symbol-drop" aria-hidden="true"></div><div><h3>Prepara</h3><p>Empieza con el rostro limpio y regálate unos segundos de calma.</p></div></article>
            <article class="ritual-step" data-lume-reveal><span class="step-number">02</span><div class="step-symbol symbol-sun" aria-hidden="true"></div><div><h3>Aplica</h3><p>Extiende unas gotas con movimientos suaves, a tu propio ritmo.</p></div></article>
            <article class="ritual-step" data-lume-reveal><span class="step-number">03</span><div class="step-symbol symbol-spark" aria-hidden="true">✳</div><div><h3>Disfruta</h3><p>Haz de esta pausa un instante para reconectar contigo.</p></div></article>
          </div>
        </section>

        <section class="closing" aria-labelledby="closing-title">
          <div class="closing-art" aria-hidden="true"><span>✳</span><span>✳</span><span>✳</span></div>
          <span class="section-kicker" data-lume-reveal>BEAUTY IN YOUR OWN LIGHT</span>
          <h2 id="closing-title" data-lume-reveal>Tu luz ya está <em>aquí.</em></h2>
          <p data-lume-reveal>Haz espacio para verla, todos los días.</p>
          <a class="button button-light" href="#inicio" data-lume-reveal>Volver al inicio <span aria-hidden="true">↑</span></a>
        </section>
      </main>

      <footer class="lume-footer">
        <a class="footer-brand" href="#inicio" aria-label="Lumé Beauty, volver al inicio">lumé<span>.</span></a>
        <nav aria-label="Navegación de pie de página"><a href="#filosofia">Filosofía</a><a href="#producto">Producto</a><a href="#ritual">Ritual</a></nav>
        <div class="footer-meta"><span>CONCEPTO DE PORTAFOLIO · 2026</span><a href="/proyectos/lume-beauty/">Volver al caso de estudio ↗</a></div>
      </footer>
    </div>
    <a class="beauty-designer-cta" href={designerWhatsapp} target="_blank" rel="noopener noreferrer">¿Quieres una web así? <strong>Hablemos por WhatsApp ↗</strong></a>
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.registerPlugin(ScrollTrigger);
        gsap.from('[data-hero-reveal]', { y: 28, opacity: 0, duration: 0.9, stagger: 0.12, ease: 'power3.out', delay: 0.1 });
        gsap.from('.bottle-hero', { y: 65, rotate: -7, opacity: 0, duration: 1.25, ease: 'power3.out', delay: 0.22 });
        gsap.utils.toArray<HTMLElement>('[data-lume-reveal]').forEach((element) => {
          gsap.from(element, {
            scrollTrigger: { trigger: element, start: 'top 88%', once: true },
            y: 38,
            opacity: 0,
            duration: 0.85,
            ease: 'power3.out',
          });
        });
      }
    </script>
  </body>
</html>
